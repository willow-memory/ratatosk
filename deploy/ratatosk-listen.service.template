# unit: ratatosk-listen@<seat>.service (instantiate per seat, e.g.
# ratatosk-listen@loki.service — %i names the seat's app_id)
#
# The ratatosk fleet activation daemon (Grove listener + heartbeat +
# per-seat bounded crown wake, sealed 3613d55e / 3566adb5). Installed and
# reinstalled through unit_install_execute (verb 17, unit.install) — never
# typed by hand, same discipline as nestor-ui.service.template and
# willow-mcp-manifest-grant.service.template. First live install is for
# LOKI (an auditor seat: read-only wake policy, no Write/Edit) — sealed
# 3566adb5: "a second seat wakes only after that receipt is read."
#
# render_values() (willow-mcp/src/willow_mcp/unit_install_executor.py) fills
# placeholders only from the INSTALLING process's own resolved environment:
# PYTHON, UNIT, WILLOW_HOME, WILLOW_STORE_ROOT, PG_DB, USER, HOME,
# XDG_CONFIG_HOME, and (when set) WILLOW_KEYRING / WILLOW_PGP_FINGERPRINT /
# NESTOR_DB. Nothing here names a placeholder outside that set — anything
# else is ETEMPLATE, refused before install, not a broken unit after one.
# %i is systemd's own instance-name specifier (the part after the ``@``),
# never a render_values() placeholder — it is how one template serves every
# seat without the installer minting one @KEY@ per app_id.
#
# ExecStart/WorkingDirectory are a documented absolute path built from
# @HOME@ (the same shape nestor-ui.service.template uses for the same
# reason: none of render_values()'s fillable keys name a SIBLING repo's
# checkout or its virtualenv beyond HOME itself, so anything more specific
# than @HOME@/... here would be unfillable and every install would refuse
# ETEMPLATE). Ratatosk's own .venv (built by its own CI/CONTRIBUTING flow)
# provides the `ratatosk-listen` console script.
#
# EnvironmentFile=@WILLOW_HOME@/env, THEN UnsetEnvironment= strips
# everything a woken seat has no business holding — the same shape
# nestor-ui.service.template and willow-mcp-manifest-grant.service.template
# use, and the same reasoning: an unauthenticated background wake reads a
# narrower slice of the operator's env than the desk does, not the whole
# file, and "wholesale" (EnvironmentFile with no UnsetEnvironment= at all)
# is exactly the shape this rule exists to refuse. A woken seat KEEPS only:
#   RATATOSK_GROVE_CHANNEL  — which Grove channel BusListener answers on
#   WILLOW_HOME             — ratatosk's own data root (paths.py) and the
#                              willow-mcp child's WILLOW_HOME (mcp_client.py
#                              forwards every WILLOW_*/RATATOSK_*/PG* var it
#                              sees in ITS OWN env to the spawned child)
#   WILLOW_MCP_APPS_ROOT, WILLOW_MCP_PYTHON — willow-mcp's own MCP
#                              coordinates, forwarded the same way, so the
#                              spawned willow-mcp child resolves this seat's
#                              manifest and app tree
#   ANTHROPIC_API_KEY, GROQ_API_KEY, CEREBRAS_API_KEY, OPENROUTER_API_KEY,
#   GEMINI_API_KEY, HF_API_KEY — the provider key_env names
#   provider_ladder.json's rungs actually read (ratatosk/provider_ladder.json);
#   a rung with no key_env (Ollama) needs none.
# Everything else UnsetEnvironment= names below is the rest of the
# documented $WILLOW_HOME/env vocabulary (nestor-ui.service.template +
# willow-mcp-manifest-grant.service.template's own comments) that this
# daemon never reads — Nestor's seal-surface keys, the desk's Postgres/
# store/vault coordinates, WILLOW_APP_ID (the CLI flag below sets it in the
# process's own environment; a stale env-file copy must not race it), and
# WILLOW_IN_KART (this is a systemd unit, never a Kart sandbox). This list
# is a snapshot of key NAMES, not values, and must be re-checked by hand
# against $WILLOW_HOME/env whenever a new key is added there — same caveat
# nestor-ui.service.template's own comment states.
#
# --wake-turns/--wake-seconds are the defaults crown.DEFAULT_WAKE_TURNS/
# DEFAULT_WAKE_SECONDS already justify (8 turns / 600s) — named explicitly
# on the command line so a reader of this unit does not have to go find the
# Python default to know the bound a woken seat here actually runs under.
#
# Long-running, not a oneshot .timer: BusListener's own poll loop already
# IS the scheduling (poll_interval, default 2s) and the heartbeat is what
# proves liveness between wakes on grove_fleet_status — a timer-triggered
# oneshot process would have no heartbeat between runs and would either
# reconnect the MCP stdio transport every tick (expensive, and racy against
# a wake still in flight) or need its own separate liveness story. No
# .timer sibling ships with this template.
[Unit]
Description=Ratatosk fleet activation daemon (Grove listener + heartbeat + wake policy) — %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@HOME@/github/willow-memory/ratatosk
EnvironmentFile=@WILLOW_HOME@/env
UnsetEnvironment=NESTOR_DB NESTOR_KEYRING NESTOR_PERSONAL_DB NESTOR_PERSONAL_LEDGER NESTOR_REQUIRE_SEAL_KEY NESTOR_SEAL_KEY WILLOW_APP_ID WILLOW_EDGE_GROQ_MODEL WILLOW_EDGE_OLLAMA_MODEL WILLOW_GEMINI_MODEL WILLOW_IN_KART WILLOW_INFERENCE_PROVIDER WILLOW_KEYRING WILLOW_NESTOR_DB WILLOW_OLLAMA_MODEL WILLOW_PGP_FINGERPRINT WILLOW_PG_DB WILLOW_PG_USER WILLOW_STORE_ROOT WILLOW_VAULT_BOX
ExecStart=@HOME@/github/willow-memory/ratatosk/.venv/bin/ratatosk-listen --app-id %i --wake-turns 8 --wake-seconds 600
# SIGTERM reaches SeatDaemon.request_stop via the signal handler installed in
# ratatosk.daemon.main; the loop exits at the next poll boundary and tears
# down the MCP stdio server in its finally — no SIGKILL escalation needed for
# an ordinary stop/restart.
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ratatosk-listen-%i

[Install]
WantedBy=default.target
